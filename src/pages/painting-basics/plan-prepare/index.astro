---
import { getCollection } from "astro:content";
import TopicLandingLayout from "../../../layouts/TopicLandingLayout.astro";
import { isDiscoverableGuide } from "../../../data/catalog";
const guides = (await getCollection("guides")).filter((guide) => isDiscoverableGuide(guide) && guide.data.category === "basics" && guide.data.topic === "plan-prepare");
---
<TopicLandingLayout {guides} />
