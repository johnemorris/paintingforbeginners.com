---
const projectPanels = [
  { src: "/images/wall.jpg", alt: "A beginner painting an interior wall" },
  { src: "/images/chair.jpg", alt: "A freshly painted outdoor chair" },
  { src: "/images/bike.jpg", alt: "A painted bicycle" },
  { src: "/images/mailbox.jpg", alt: "A painted mailbox" },
  { src: "/images/cabinet.jpg", alt: "Painted blue cabinets" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Painting for Beginners — beginner-friendly painting help for walls, furniture, bikes, mailboxes, cabinets, outdoor projects and more."
    />
    <title>Painting for Beginners — Coming Soon</title>
    <style>
      :root {
        --navy: #102d4b;
        --teal: #128fa0;
        --coral: #ef5a47;
        --yellow: #f5b800;
        --paper: #fffdf9;
        --cream: #f4efe7;
        --muted: #566575;
        --blue-tape: #1f69d5;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--navy);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .site-shell {
        min-height: 100vh;
        overflow: hidden;
        background:
          radial-gradient(circle at 5% 8%, rgba(18,143,160,.08), transparent 22rem),
          linear-gradient(180deg, #fff 0, var(--paper) 100%);
      }

      header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        width: min(1280px, calc(100% - 32px));
        margin: 0 auto;
        min-height: 92px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: .8rem;
        font-weight: 950;
        letter-spacing: -.045em;
        font-size: clamp(1.45rem, 2vw, 2.2rem);
      }

      .brand-mark {
        width: 42px;
        height: 54px;
        position: relative;
        transform: rotate(8deg);
      }
      .brand-mark::before {
        content:"";
        position:absolute;
        left:9px; top:0;
        width:24px; height:25px;
        background:var(--teal);
        border:4px solid var(--navy);
        border-radius:4px;
      }
      .brand-mark::after {
        content:"";
        position:absolute;
        left:17px; top:26px;
        width:9px; height:27px;
        background:var(--navy);
        border-radius:2px 2px 5px 5px;
      }

      .brand em {
        display:block;
        margin-top:-.35rem;
        margin-left:1.4rem;
        color:var(--teal);
        font-family:"Segoe Print","Bradley Hand",cursive;
        font-size:.75em;
        font-weight:800;
        letter-spacing:-.03em;
      }

      nav {
        display:flex;
        gap:2rem;
        align-items:center;
        font-size:.86rem;
        font-weight:850;
      }
      nav a { color:inherit; text-decoration:none; }
      nav a:hover { color:var(--teal); }

      .coming-pill {
        padding:.7rem 1rem;
        color:white;
        font-weight:950;
        text-transform:uppercase;
        letter-spacing:.04em;
        background:var(--teal);
        clip-path:polygon(3% 8%, 97% 0, 100% 84%, 5% 100%, 0 25%);
      }

      .hero {
        position:relative;
        min-height:720px;
        border-top:1px solid #e8e5df;
        background:#e8f0f1;
        isolation:isolate;
      }

      .collage {
        position:absolute;
        inset:0;
        display:grid;
        grid-template-columns: 1.55fr .9fr .82fr .95fr 1fr;
        gap:4px;
        overflow:hidden;
      }
      .panel {
        position:relative;
        overflow:hidden;
        background:#ddd;
      }
      .panel img {
        width:100%;
        height:100%;
        object-fit:cover;
        display:block;
      }
      .panel:nth-child(1) img { object-position: 48% center; }
      .panel:nth-child(2) img { object-position: center; }
      .panel:nth-child(3) img { object-position: 50% center; }
      .panel:nth-child(4) img { object-position: center; }
      .panel:nth-child(5) img { object-position: 42% center; }

      .collage::after {
        content:"";
        position:absolute;
        inset:0;
        background:
          linear-gradient(90deg, rgba(5,34,54,.58) 0%, rgba(5,34,54,.32) 27%, rgba(5,34,54,0) 49%);
        pointer-events:none;
      }

      .hero-copy {
        position:relative;
        z-index:5;
        width:min(1280px, calc(100% - 32px));
        margin:0 auto;
        padding-top:78px;
      }

      .copy-card {
        width:min(510px, 45vw);
        color:#fff;
        text-shadow:0 2px 12px rgba(0,0,0,.28);
      }

      h1 {
        margin:0;
        font-size:clamp(3.6rem, 6.4vw, 6.7rem);
        line-height:.86;
        letter-spacing:-.065em;
        text-transform:uppercase;
        font-weight:1000;
      }

      .start-here {
        display:inline-block;
        margin:.45rem 0 .8rem;
        color:var(--yellow);
        font-family:"Segoe Print","Bradley Hand",cursive;
        font-size:clamp(2.5rem,4.8vw,4.7rem);
        line-height:1;
        font-weight:900;
        transform:rotate(-2deg);
        border-bottom:6px solid rgba(245,184,0,.95);
      }

      .hero-copy p {
        margin:.5rem 0 0;
        max-width:470px;
        font-size:clamp(1rem,1.6vw,1.25rem);
        font-weight:750;
        line-height:1.45;
      }
      .hero-copy p span { color:#90e5ed; font-style:italic; }

      .signup-wrap {
        position:absolute;
        z-index:12;
        left:50%;
        bottom:30px;
        transform:translateX(-50%);
        width:min(520px, calc(100% - 36px));
      }

      .signup {
        position:relative;
        background:rgba(255,255,255,.96);
        border:1px solid rgba(17,45,73,.12);
        box-shadow:0 18px 50px rgba(6,31,49,.22);
        border-radius:16px;
        padding:28px 28px 22px;
        text-align:center;
      }

      .signup::before,
      .signup::after {
        content:"";
        position:absolute;
        width:82px;
        height:28px;
        background:rgba(31,105,213,.88);
        top:-14px;
      }
      .signup::before { left:34px; transform:rotate(-4deg); }
      .signup::after { right:30px; transform:rotate(4deg); }

      .signup h2 {
        margin:0;
        font-size:1.55rem;
        letter-spacing:-.035em;
      }
      .signup p {
        margin:.45rem auto 1rem;
        color:var(--muted);
        line-height:1.45;
        max-width:410px;
      }

      form {
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:.7rem;
      }
      input {
        width:100%;
        border:1px solid #cfd7de;
        border-radius:8px;
        padding:.9rem .95rem;
        font:inherit;
        background:white;
        color:var(--navy);
      }
      button {
        grid-column:1/-1;
        border:0;
        border-radius:9px;
        padding:1rem;
        background:var(--teal);
        color:white;
        font:inherit;
        font-weight:950;
        text-transform:uppercase;
        letter-spacing:.02em;
        cursor:pointer;
      }
      button:hover { filter:brightness(.94); }
      .privacy {
        margin:.65rem 0 0 !important;
        font-size:.76rem;
        color:#73808c !important;
      }

      .tarp {
        position:absolute;
        z-index:9;
        right:-3vw;
        bottom:-34px;
        width:min(57vw, 820px);
        height:400px;
        overflow:hidden;
        clip-path:polygon(17% 17%, 35% 5%, 55% 14%, 72% 2%, 100% 10%, 100% 100%, 0 100%, 5% 53%);
        filter:drop-shadow(-18px -8px 18px rgba(6,31,49,.16));
      }
      .tarp img {
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:68% 64%;
        display:block;
      }

      .tape {
        position:absolute;
        z-index:13;
        width:78px;
        height:27px;
        background:rgba(31,105,213,.92);
        transform:rotate(-7deg);
      }
      .tape.one { right:31%; bottom:350px; }
      .tape.two { right:4%; top:95px; transform:rotate(12deg); }

      .features {
        position:relative;
        z-index:15;
        display:grid;
        grid-template-columns:repeat(4,1fr);
        gap:0;
        background:#fff;
        border-top:1px solid #e5e5e5;
      }
      .feature {
        padding:24px 22px 28px;
        text-align:center;
        border-right:1px solid #e5e5e5;
      }
      .feature:last-child{border-right:0}
      .feature strong {
        display:block;
        font-size:1rem;
        margin-bottom:.25rem;
      }
      .feature span {
        color:var(--muted);
        font-size:.85rem;
      }

      footer {
        padding:22px 16px 30px;
        text-align:center;
        color:#73808c;
        font-size:.8rem;
      }

      @media (max-width: 900px) {
        nav { display:none; }
        header { min-height:76px; }
        .hero { min-height:880px; }
        .collage { grid-template-columns:1.6fr 1fr 1fr; }
        .panel:nth-child(4), .panel:nth-child(5) { display:none; }
        .copy-card { width:min(540px, 84vw); }
        .tarp { width:78vw; height:390px; right:-14vw; }
        .signup-wrap { bottom:28px; }
        .features { grid-template-columns:1fr 1fr; }
        .feature:nth-child(2){border-right:0}
      }

      @media (max-width: 620px) {
        .brand { font-size:1.2rem; }
        .coming-pill { font-size:.72rem; }
        .hero { min-height:960px; }
        .collage { grid-template-columns:1fr 1fr; }
        .panel:nth-child(3){display:none}
        .collage::after {
          background:linear-gradient(180deg, rgba(5,34,54,.62) 0 47%, rgba(5,34,54,.12) 70%, transparent 100%);
        }
        .hero-copy { padding-top:46px; }
        .copy-card { width:92%; }
        h1 { font-size:clamp(3.4rem,17vw,5rem); }
        .start-here { font-size:clamp(2.7rem,14vw,4rem); }
        .tarp {
          width:115vw;
          right:-28vw;
          bottom:120px;
          height:380px;
          opacity:.97;
        }
        .signup-wrap { bottom:24px; }
        .signup { padding:24px 18px 18px; }
        form { grid-template-columns:1fr; }
        button { grid-column:auto; }
        .features { grid-template-columns:1fr 1fr; }
        .feature { padding:18px 12px; }
      }
    </style>
  </head>

  <body>
    <div class="site-shell">
      <header>
        <div class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>PAINTING <em>for Beginners</em></span>
        </div>

        <nav aria-label="Main navigation">
          <a href="#projects">Projects</a>
          <a href="#paint101">Paint 101</a>
          <a href="#mistakes">Fix a Mistake</a>
          <a href="#about">About</a>
        </nav>

        <div class="coming-pill">Coming Soon</div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="collage" aria-hidden="true">
            {projectPanels.map((panel) => (
              <div class="panel">
                <img src={panel.src} alt="" loading="eager" />
              </div>
            ))}
          </div>

          <div class="hero-copy">
            <div class="copy-card">
              <h1 id="hero-title">Never painted it before?</h1>
              <div class="start-here">Start here.</div>
              <p>
                Walls. Furniture. Bikes. Mailboxes. Cabinets. Outdoor projects.
                <span>And more.</span>
              </p>
            </div>
          </div>

          <div class="tarp" aria-hidden="true">
            <img src="/images/tarp.jpg" alt="" />
          </div>
          <span class="tape one" aria-hidden="true"></span>
          <span class="tape two" aria-hidden="true"></span>

          <div class="signup-wrap" hidden>
            <div class="signup">
              <h2>PaintingForBeginners.com is coming soon!</h2>
              <p>
                Join the launch list for beginner-friendly guides, tips and
                step-by-step painting projects.
              </p>

              <!--
                The form is intentionally not wired to a provider yet.
                Replace action="#" with your newsletter endpoint before production.
              -->
              <form id="launch-form" action="#" method="post">
                <label>
                  <span class="sr-only"></span>
                  <input name="name" autocomplete="name" placeholder="Your name" required />
                </label>
                <label>
                  <span class="sr-only"></span>
                  <input type="email" name="email" autocomplete="email" placeholder="Your email address" required />
                </label>
                <button type="submit">Notify me when we launch →</button>
              </form>
              <p class="privacy">No spam. Just the launch notice and useful painting updates.</p>
            </div>
          </div>
        </section>

        <section class="features" aria-label="What to expect">
          <div class="feature"><strong>Real Projects</strong><span>Things you actually want to paint.</span></div>
          <div class="feature"><strong>Simple Steps</strong><span>Written for true beginners.</span></div>
          <div class="feature"><strong>Helpful Tips</strong><span>Avoid the mistakes we all make.</span></div>
          <div class="feature"><strong>Great Results</strong><span>You can absolutely do this.</span></div>
        </section>
      </main>

      <footer>© {new Date().getFullYear()} PaintingForBeginners.com</footer>
    </div>

    <script>
      const form = document.querySelector("#launch-form");
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const button = form.querySelector("button");
        if (button) button.textContent = "Signup opens soon";
      });
    </script>
  </body>
</html>
