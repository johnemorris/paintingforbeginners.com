---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideList from "../components/GuideList.astro";
import { categories, site } from "../data/site";
import { isDiscoverableGuide, sortGuides } from "../data/catalog";
const guides = (await getCollection("guides")).filter(isDiscoverableGuide);
const featured = sortGuides(guides.filter((guide) => guide.data.featured)).slice(0, 6);
const paths = [
  { key: "home", copy: "Walls, ceilings, trim, doors, and the order that keeps a room manageable." },
  { key: "furniture", copy: "Wood, laminate, and everyday pieces that deserve a useful second life." },
  { key: "canvas", copy: "Acrylic supplies, first-canvas skills, and projects made for practice." },
  { key: "basics", copy: "Primer, preparation, coverage, drying, and the terms on the paint can." },
] as const;
---
<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="hero-images" aria-hidden="true"><img src="/images/wall.jpg" alt="" /><img src="/images/chair.jpg" alt="" /><img src="/images/cabinet.jpg" alt="" /></div>
    <div class="wrap hero-content"><div><p class="eyebrow">Practical painting help, minus the intimidation</p><h1>Never painted it before?</h1><p class="start">Start here.</p><p class="lead">We show you what you need, what to skip, and what to do next—for rooms, furniture, everyday projects, and your first canvas.</p><div class="actions"><a class="button" href="/how-to-paint-a-room/">Paint your first room</a><a class="button secondary" href="/acrylic-painting-for-beginners/">Try a first canvas</a></div></div></div>
  </section>
  <section class="section"><div class="wrap"><p class="eyebrow">Choose what you're painting</p><h2>Find the right place to begin</h2><div class="path-grid">{paths.map(({ key, copy }, index) => { const item = categories[key]; return <a class="path" href={item.href}><span>0{index + 1}</span><h3>{item.title}</h3><p>{copy}</p><strong>Explore guides →</strong></a>; })}</div></div></section>
  <section class="section tint"><div class="wrap"><p class="eyebrow">The useful first steps</p><h2>Beginner guides that prevent rework</h2><p class="lead">Start with a complete project, or solve the preparation question that is holding you up.</p><GuideList guides={featured} /></div></section>
  <section class="section"><div class="wrap reassurance"><div><p class="eyebrow">If it already went wrong</p><h2>Most paint mistakes are fixable.</h2><p class="lead">Stop working the wet paint, let it dry, and diagnose the surface before adding another coat. Our guides explain why peeling, ridges, patchy color, and muddy acrylic mixtures happen.</p></div><a class="button" href="/surface-preparation-before-painting/">Check the surface first</a></div></section>
  <section class="supply-strip"><div class="wrap"><div><p class="eyebrow">Buy less, choose better</p><h2>Tools should solve a job—not fill a cart.</h2></div><p>Our supply lists explain what each item does before recommending anything to buy. There are currently no paid product links.</p><a class="button secondary" href="/supplies-tools/">Understand the tools</a></div></section>
</BaseLayout>
<style>
  .hero { position: relative; min-height: 42rem; overflow: hidden; background: var(--blue-wash); isolation: isolate; }
  .hero::after { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgb(8 34 51 / .92) 0 46%, rgb(8 34 51 / .5) 68%, transparent); content: ""; }
  .hero-images { position: absolute; z-index: -2; inset: 0; display: grid; grid-template-columns: 1.7fr 1fr 1fr; gap: .25rem; }
  .hero-images img { width: 100%; height: 100%; object-fit: cover; }
  .hero-content { display: flex; min-height: 42rem; align-items: center; padding-block: var(--space-5); }
  .hero-content > div { max-width: 42rem; color: white; }
  .hero h1 { color: white; }
  .hero .eyebrow { color: #8fdee1; }
  .hero .lead { color: #eef7f6; }
  .start { margin: .2rem 0 var(--space-3); color: #ffd45e; font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, 5rem); font-style: italic; font-weight: 700; line-height: 1; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: var(--space-4); }
  .hero .secondary { border-color: white; color: white; }
  .path-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .path { min-height: 18rem; padding: var(--space-4); background: white; color: var(--ink); text-decoration: none; }
  .path:hover { background: var(--blue-wash); color: var(--ink); }
  .path span { color: var(--coral); font-size: .8rem; font-weight: 900; }
  .path h3 { margin-top: var(--space-4); font-family: var(--font-display); font-size: 1.65rem; }
  .path p { color: var(--muted); }
  .path strong { color: var(--teal-dark); }
  .reassurance { display: flex; align-items: end; justify-content: space-between; gap: var(--space-5); }
  .supply-strip { padding-block: var(--space-5); background: var(--ochre); color: var(--ink-strong); }
  .supply-strip .wrap { display: grid; grid-template-columns: 1.2fr 1fr auto; align-items: center; gap: var(--space-5); }
  .supply-strip h2, .supply-strip p { margin: 0; }
  @media (max-width: 900px) { .path-grid { grid-template-columns: 1fr 1fr; } .supply-strip .wrap { grid-template-columns: 1fr; gap: var(--space-3); } }
  @media (max-width: 600px) { .hero, .hero-content { min-height: 39rem; } .hero::after { background: rgb(8 34 51 / .77); } .hero-images { grid-template-columns: 1fr 1fr; } .hero-images img:last-child { display: none; } .path-grid { grid-template-columns: 1fr; } .path { min-height: 0; } .reassurance { align-items: flex-start; flex-direction: column; } }
</style>
