---
import { getCollection, render } from "astro:content";
import GuideLayout from "../layouts/GuideLayout.astro";
import { isPublishedGuide } from "../data/catalog";

export async function getStaticPaths() {
  const guides = (await getCollection("guides")).filter(isPublishedGuide);
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry, guides } }));
}

const { entry, guides } = Astro.props;
const { Content, headings } = await render(entry);
const relatedGuides = entry.data.related.map((id) => guides.find((guide) => guide.id === id)).filter(Boolean);
---
<GuideLayout {entry} {relatedGuides} {headings}><Content /></GuideLayout>
