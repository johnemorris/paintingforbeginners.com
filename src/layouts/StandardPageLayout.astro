---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
const { title, description, eyebrow = "Painting for Beginners", noindex = false } = Astro.props;
---
<BaseLayout {title} {description} {noindex}>
  <header class="page-hero"><div class="narrow"><Breadcrumbs items={[{ label: title }]} /><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lead">{description}</p></div></header>
  <article class="narrow prose"><slot /></article>
</BaseLayout>
<style>
  .page-hero { padding: var(--space-5) 0; background: var(--blue-wash); }
  .page-hero .eyebrow { margin-top: var(--space-4); }
  .prose { padding-block: var(--space-5) var(--space-6); }
  .prose :global(li) { margin-bottom: .5rem; }
  .prose :global(.notice) { padding: var(--space-3); border-left: 5px solid var(--ochre); background: #fff7dc; }
</style>
