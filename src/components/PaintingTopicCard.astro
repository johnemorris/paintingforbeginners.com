---
import type { CollectionEntry } from "astro:content";
const { topic, visual, guides } = Astro.props as { topic: { id: string; title: string; description: string }; visual: any; guides: CollectionEntry<"guides">[] };
const featured = visual.featured.slice(0, 3).map((id: string) => guides.find((guide) => guide.id === id)).filter(Boolean);
const count = guides.filter((guide) => guide.data.topic === topic.id).length;
---
<article class="topic-card">
  <div class="topic-image"><img src={visual.image.src} alt={visual.image.alt} loading="lazy" width="1200" height="800" /></div>
  <div class="topic-copy">
    <h3>{topic.title}</h3>
    <p>{topic.description}</p>
    <ul>{featured.map((guide: CollectionEntry<"guides">) => <li><a href={`/${guide.id}/`}>{guide.data.title}</a></li>)}</ul>
    <a class="topic-cta" href={visual.href}>Explore all {count} {count === 1 ? "guide" : "guides"} <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
  .topic-card { display: flex; min-width: 0; min-height: 100%; flex-direction: column; overflow: hidden; border-radius: var(--radius); background: white; box-shadow: var(--shadow-soft); }
  .topic-image img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .topic-copy { display: flex; flex: 1; flex-direction: column; padding: var(--space-3); }
  h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: 1.45rem; }
  .topic-copy > p:not(.topic-count) { color: var(--muted); }
  ul { margin: var(--space-2) 0 var(--space-3); padding: var(--space-2) 0; border-block: 1px solid var(--line); list-style: none; }
  li + li { margin-top: .4rem; }
  li a { color: var(--ink); font-size: .82rem; font-weight: 750; line-height: 1.35; text-decoration-thickness: 1px; }
  .topic-cta { margin-top: auto; font-size: .88rem; font-weight: 850; }
</style>
