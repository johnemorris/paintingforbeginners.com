---
import type { CollectionEntry } from "astro:content";

interface Topic {
  id: string;
  title: string;
  description: string;
}

interface Props {
  guides: CollectionEntry<"guides">[];
  startHere: string;
  topics?: readonly Topic[];
}

const { guides, startHere, topics = [] } = Astro.props;
const sortedGuides = [...guides].sort((a, b) => a.data.title.localeCompare(b.data.title));
const startGuide = sortedGuides.find((guide) => guide.id === startHere);

if (guides.length > 0 && !startGuide) {
  throw new Error(`Category directory start guide "${startHere}" is missing or belongs to another category.`);
}

const topicIds = new Set(topics.map((topic) => topic.id));
if (topics.length > 0) {
  const invalidGuides = guides.filter((guide) => !guide.data.topic || !topicIds.has(guide.data.topic));
  if (invalidGuides.length > 0) {
    throw new Error(`Category directory guides have missing or unknown topics: ${invalidGuides.map((guide) => guide.id).join(", ")}`);
  }
}

const remainingGuides = sortedGuides.filter((guide) => guide.id !== startHere);
const sections = topics.map((topic) => ({
  ...topic,
  guides: remainingGuides.filter((guide) => guide.data.topic === topic.id),
})).filter((topic) => topic.guides.length > 0);
---

{guides.length === 0 ? (
  <p class="directory-empty">New beginner guides are on the way.</p>
) : (
  <>
    {startGuide && (
      <section class="start-here" aria-labelledby="start-here-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 id="start-here-heading"><a href={`/${startGuide.id}/`}>{startGuide.data.title}</a></h2>
          <p>{startGuide.data.description}</p>
        </div>
        <a class="button" href={`/${startGuide.id}/`}>Read the guide <span aria-hidden="true">→</span></a>
      </section>
    )}

    {remainingGuides.length > 0 && (
      <section class="directory" aria-labelledby="directory-heading">
        <div class="directory-heading">
          <div>
            <p class="eyebrow">Find your next step</p>
            <h2 id="directory-heading">Browse beginner guides</h2>
          </div>
          <p>{guides.length} guides in this category</p>
        </div>

        {sections.length > 1 && (
          <nav class="topic-nav" aria-label="Topics in this category">
            {sections.map((section) => <a href={`#${section.id}`}>{section.title}<span>{section.guides.length}</span></a>)}
          </nav>
        )}

        {sections.length > 0 ? (
          <div class="topic-sections">
            {sections.map((section) => (
              <section class="topic" id={section.id} aria-labelledby={`${section.id}-heading`}>
                <header>
                  <h3 id={`${section.id}-heading`}>{section.title}</h3>
                  <p>{section.description}</p>
                </header>
                <ul>
                  {section.guides.map((guide) => (
                    <li>
                      <h4><a href={`/${guide.id}/`}>{guide.data.title}<span aria-hidden="true">→</span></a></h4>
                      <p>{guide.data.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <ul class="guide-rows">
            {remainingGuides.map((guide) => (
              <li>
                <h3><a href={`/${guide.id}/`}>{guide.data.title}<span aria-hidden="true">→</span></a></h3>
                <p>{guide.data.description}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}
  </>
)}

<style>
  .directory-empty { padding: var(--space-4); border: 1px solid var(--line); background: white; }
  .start-here { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-5); margin: var(--space-5) 0 var(--space-6); padding: var(--space-4); border-left: .4rem solid var(--coral); background: white; box-shadow: var(--shadow); }
  .start-here h2 { max-width: 48rem; margin: 0 0 var(--space-2); font-size: clamp(1.65rem, 3vw, 2.35rem); }
  .start-here h2 a { color: var(--ink-strong); text-decoration: none; }
  .start-here h2 a:hover { color: var(--teal-dark); text-decoration: underline; }
  .start-here p:last-child { max-width: 54rem; margin-bottom: 0; color: var(--muted); }
  .start-here .button { white-space: nowrap; }
  .directory-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--line); }
  .directory-heading h2 { margin: 0; }
  .directory-heading > p { margin: 0; color: var(--muted); font-size: .88rem; font-weight: 750; white-space: nowrap; }
  .topic-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; }
  .topic-nav a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .55rem; padding: .55rem .8rem; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--ink); font-size: .86rem; font-weight: 800; text-decoration: none; }
  .topic-nav a:hover { border-color: var(--teal); background: var(--blue-wash); color: var(--teal-dark); }
  .topic-nav span { display: inline-grid; min-width: 1.45rem; height: 1.45rem; place-items: center; border-radius: 999px; background: var(--blue-wash); color: var(--teal-dark); font-size: .75rem; }
  .topic-sections { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--space-4); margin-top: var(--space-4); }
  .topic { scroll-margin-top: var(--space-3); border-top: .3rem solid var(--teal); background: white; box-shadow: 0 2px 0 rgb(20 50 66 / .08); }
  .topic header { padding: var(--space-3) var(--space-3) var(--space-2); }
  .topic header h3 { margin: 0 0 var(--space-1); font-family: var(--font-display); font-size: 1.45rem; }
  .topic header p { margin: 0; color: var(--muted); font-size: .9rem; }
  .topic ul, .guide-rows { margin: 0; padding: 0; list-style: none; }
  .topic li, .guide-rows li { padding: var(--space-3); border-top: 1px solid var(--line); }
  .topic h4, .guide-rows h3 { margin: 0; font-size: 1.02rem; line-height: 1.3; }
  .topic h4 a, .guide-rows h3 a { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); color: var(--ink-strong); text-decoration: none; }
  .topic h4 a:hover, .guide-rows h3 a:hover { color: var(--teal-dark); text-decoration: underline; }
  .topic h4 span, .guide-rows h3 span { flex: 0 0 auto; color: var(--coral); }
  .topic li p, .guide-rows li p { margin: var(--space-1) 0 0; color: var(--muted); font-size: .86rem; line-height: 1.5; }
  .guide-rows { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--space-4); border: 1px solid var(--line); background: white; }
  .guide-rows li:nth-child(even) { border-left: 1px solid var(--line); }
  @media (max-width: 760px) {
    .start-here { grid-template-columns: 1fr; align-items: start; gap: var(--space-3); }
    .start-here .button { justify-self: start; white-space: normal; }
    .directory-heading { align-items: start; flex-direction: column; gap: var(--space-2); }
    .topic-nav { flex-wrap: nowrap; margin-inline: -1rem; padding: 0 1rem var(--space-1); overflow-x: auto; }
    .topic-nav a { flex: 0 0 auto; }
    .topic-sections, .guide-rows { grid-template-columns: 1fr; }
    .guide-rows li:nth-child(even) { border-left: 0; }
  }
</style>
