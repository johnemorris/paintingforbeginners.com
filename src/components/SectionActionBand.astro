---
import type { SectionLandingConfig } from "../data/section-landings";

interface Props {
  band: SectionLandingConfig["actionBands"][number];
  categoryTitle: string;
}

const { band, categoryTitle } = Astro.props;
---
<section class:list={["section", "action-section", `action-${band.kind}`]}>
  <div class="wrap action-layout">
    <div>
      <p class="eyebrow">{band.eyebrow}</p>
      <h2>{band.heading}</h2>
      <p class="lead">{band.lead}</p>
    </div>
    <nav aria-label={`${band.eyebrow} for ${categoryTitle}`}>
      {band.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>)}
    </nav>
  </div>
</section>

<style>
  .action-section { color: white; }
  .action-kit { background: var(--teal-dark); }
  .action-practice { background: var(--ink-strong); }
  .action-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, .8fr); gap: var(--space-5); align-items: center; }
  h2, .lead { color: white; }
  .eyebrow { color: #b8ece8; }
  nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  nav a { display: flex; min-height: 3.2rem; align-items: center; justify-content: space-between; gap: var(--space-2); padding: .7rem 1rem; border: 1px solid rgb(255 255 255 / .3); border-radius: var(--radius-sm); color: white; font-weight: 800; text-decoration: none; }
  nav a:hover { background: white; color: var(--teal-dark); }
  @media (max-width: 820px) { .action-layout { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { nav { grid-template-columns: 1fr; } }
</style>
