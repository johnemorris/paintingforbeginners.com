---
interface Heading { depth: number; slug: string; text: string }
const { headings } = Astro.props as { headings: Heading[] };
const sections = headings.filter((heading) => heading.depth === 2);
---
{sections.length > 2 && <details class="guide-toc" open><summary>In this guide</summary><nav aria-label="In this guide"><ol>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details>}
<style>
  .guide-toc { position: sticky; top: var(--space-3); padding: var(--space-3); border-top: .3rem solid var(--teal); border-radius: var(--radius-sm); background: white; box-shadow: var(--shadow-soft); }
  summary { color: var(--ink-strong); font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  nav { margin-top: var(--space-2); }
  ol { margin: 0; padding: 0; counter-reset: toc; list-style: none; }
  li { position: relative; padding: .5rem 0 .5rem 1.7rem; border-top: 1px solid var(--line); counter-increment: toc; font-size: .82rem; line-height: 1.35; }
  li::before { position: absolute; left: 0; color: var(--coral-dark); content: counter(toc, decimal-leading-zero); font-size: .68rem; font-weight: 850; }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: var(--teal-dark); text-decoration: underline; }
  @media (min-width: 981px) { summary { pointer-events: none; } }
  @media (max-width: 980px) { .guide-toc { position: static; margin-bottom: var(--space-4); } }
</style>
